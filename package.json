{
  "name": "mx-player-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maishan-Inc/MX-Player-Pro.git"
  },
  "files": [
    "dist-lib"
  ],
  "exports": {
    ".": "./dist-lib/mx-player.js",
    "./vue": "./dist-lib/mx-player-vue.js",
    "./react": "./dist-lib/mx-player-react.js",
    "./wasm/*": "./dist-lib/wasm/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:wasm && tsc -b && vite build",
    "build:lib": "pnpm build:wasm && tsc -b && node scripts/build-lib.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc -b --pretty false",
    "build:wasm": "node scripts/build-wasm.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
